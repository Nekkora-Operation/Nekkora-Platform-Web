{
  "name": "nekkora-platform-web",
  "version": "0.1.0",
  "private": true,
  "description": "Nekkora Platform — frontend (Authentication V1).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run contract:check && npm run build",
    "lib:prepare": "node scripts/lib.mjs prepare",
    "lib:verify": "node scripts/lib.mjs verify",
    "predev": "node scripts/check-lib.mjs",
    "prebuild": "node scripts/check-lib.mjs",
    "pretest": "node scripts/check-lib.mjs",
    "contract:gen": "node scripts/contract.mjs gen",
    "contract:check": "node scripts/contract.mjs check",
    "contract:sync": "node scripts/contract.mjs sync"
  },
  "dependencies": {
    "nekkora-lib": "file:.deps/pack/nekkora-lib-0.2.0.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
